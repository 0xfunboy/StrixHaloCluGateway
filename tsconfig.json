{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "vscode"],
    "allowImportingTsExtensions": true, "noEmit": true, "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "web/**/*.ts", "vscode/src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
